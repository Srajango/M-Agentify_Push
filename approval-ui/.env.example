# Build-time base URL the browser bundle will call for the orchestrator's human-gate
# endpoints and health check. Baked into the static bundle at `vite build` time.
VITE_ORCHESTRATOR_BASE_URL=
# Build-time request timeout (milliseconds) applied to every orchestrator call.
VITE_ORCHESTRATOR_TIMEOUT_MS=5000

# Node-only test/sandbox toggle read via process.env (never shipped to the browser
# bundle because it has no VITE_ prefix). When "true", orchestratorClient returns
# canned fixtures instead of calling the network. Leave unset for a real build.
DRY_RUN=
