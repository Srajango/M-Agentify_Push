# DRY_RUN switches the orchestrator event-publishing transport seam only.
# true  -> events are logged instead of sent over the network (used by tests and local loops).
# false -> events are POSTed to ORCHESTRATOR_EVENTS_URL via httpx.
DRY_RUN=true

# Leave blank/unset so the service falls back to an in-process SQLite database
# (no live infrastructure URL is pinned here). When set in production, use the
# psycopg3 dialect this service installs, e.g.
# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# Base URL of the orchestrator event bus that receives this service's domain events.
# Only read when DRY_RUN=false.
ORCHESTRATOR_EVENTS_URL=http://orchestrator.internal/events

# Round-robin assignment and rate card tuning.
RATE_CARD_THIRD_PARTY_BASE_PREMIUM=2072.00
RATE_CARD_OWN_DAMAGE_RATE=0.035
